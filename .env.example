# B-Roll Agent Configuration
# Copy this to .env and fill in your values

# Pexels API Key (free from https://www.pexels.com/api/)
# Optional: Pinterest + fallback catalog work without it
PEXELS_API_KEY=

# Google Gemini API Key (free from https://aistudio.google.com/apikey)
# Required for Tamil/Hindi/non-English transcript translation
GEMINI_API_KEY=

# Set to 0 to force CPU mode (default: 1 = use CUDA if available)
USE_CUDA=1

# Hosted mode (production branch): keys stay session-only and can be read
# from the host's secret store; set 1 when deploying on a shared host.
EDIT_HELPER_HOSTED=0

# Shared access code for a hosted deployment (a simple gate, not per-user
# accounts). REQUIRED when EDIT_HELPER_HOSTED=1 - the hosted app refuses to
# load without it.
EDIT_HELPER_ACCESS_CODE=
